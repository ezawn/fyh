        },
        {
          "speaker": "Gojo",
          "text": "Welcome back, Yuji. You're going to need a lot of training."
        }
      ],
      "playerDefeated": [
        {
          "speaker": "Sukuna",
          "text": "The strongest? Don't make me laugh. Come back with a real technique."
