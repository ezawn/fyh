      "roomIntro": [
        [
          {
            "speaker": "Gojo",
            "text": "A special grade cursed object loose at a high school at night. Sure, why not."
          },
          {
            "speaker": "Gojo",
            "text": "Low-grade curses crawling everywhere. Relax, the strongest just showed up."
          }
        ],
        [
          {
            "speaker": "Gojo",
            "text": "These halls reek of cursed energy. Somebody swallowed something they really shouldn't have."
          },
          {
            "speaker": "Gojo",
            "text": "Mind the floor. Curses love a building nobody's watching."
          }
        ],
        [
          {
            "speaker": "Gojo",
            "text": "Up on the roof? Let's see who's really in charge of that body."
          }
        ]
      ],
      "bossIntro": [
        {
          "speaker": "Sukuna",
          "text": "So you're this era's strongest. Entertain me before the brat takes his body back."
        },
        {
          "speaker": "Gojo",
          "text": "Ten seconds. If Yuji's still in there, he can come back after."
        }
      ],
