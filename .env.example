# Copy to .env and fill in. Never commit .env. Server only: the browser never sees these.
PORT=3001

# Snowflake (SPEC 8.4). Setup SQL: server/sql/setup.sql
SNOWFLAKE_ACCOUNT=            # <orgname>-<accountname>, from the last query in setup.sql
SNOWFLAKE_USER=RETRO_SERVER
SNOWFLAKE_ROLE=RETRO_APP
SNOWFLAKE_WAREHOUSE=RETRO_WH
SNOWFLAKE_DATABASE=RETRO
SNOWFLAKE_SCHEMA=PUBLIC
# Login: a key-pair path (recommended, no MFA prompt) or a password.
SNOWFLAKE_PRIVATE_KEY_PATH=   # e.g. C:/Users/you/.snowflake/retro_rsa_key.p8 (keep it outside the repo)
SNOWFLAKE_PASSWORD=

# AI backend for generation + remix lines (server/ai.ts). Snowflake trial accounts can't
# call Cortex AI_COMPLETE, so the default is the Anthropic API whenever a key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PROVIDER=                  # anthropic | gemini | cortex (blank = anthropic if its key is set, else gemini if its key is set, else AI is off)

# Google Gemini (free tier: https://aistudio.google.com/apikey). About 20 requests a day per model,
# so list several: when one runs out the next is used. One generation takes about 8 requests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
# Check with: npx tsx server/check-ai.ts

# Cortex model, only used with AI_PROVIDER=cortex on a paid account (npx tsx server/check-cortex.ts)
CORTEX_MODEL=claude-opus-5-5
